# ANTHROPIC_API_KEY: For Claude 3.7 script generation and voice optimization.
ANTHROPIC_API_KEY="MY_ANTHROPIC_API_KEY"

# ANTHROPIC_WORKSPACE_ID: (Optional) If your Anthropic API key requires a workspace ID.
ANTHROPIC_WORKSPACE_ID=""

# GEMINI_API_KEY: (Optional) If you want Google Gemini Neural Voice.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
